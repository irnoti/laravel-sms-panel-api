{
    "name": "irnoti/laravel-sms-panel-api",
    "description": "Official Laravel SDK for the irnoti platform API — SMS (single, bulk, pattern, scheduled, gradual, SOS), provider services, phonebook, link tracker, number banks, verify, bots and VoIP, with a typed fluent client and webhook verification.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sms",
        "sms-api",
        "sdk",
        "api-client",
        "irnoti",
        "sms-panel",
        "bulk-sms",
        "sms-gateway"
    ],
    "homepage": "https://github.com/irnoti/laravel-sms-panel-api",
    "support": {
        "issues": "https://github.com/irnoti/laravel-sms-panel-api/issues",
        "source": "https://github.com/irnoti/laravel-sms-panel-api",
        "docs": "https://irnoti.com/docs"
    },
    "authors": [
        {
            "name": "irnoti",
            "email": "support@irnoti.com",
            "homepage": "https://irnoti.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.20|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Irnoti\\SmsPanelApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Irnoti\\SmsPanelApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Irnoti\\SmsPanelApi\\SmsPanelApiServiceProvider"
            ],
            "aliases": {
                "Irnoti": "Irnoti\\SmsPanelApi\\Facades\\Irnoti"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
